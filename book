<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="theme-color" content="#FF6B9D">
<title>Nail Kloset — จองคิว</title>

<!-- LINE LIFF SDK -->
<script src="https://static.line-scdn.net/liff/edge/versions/2.22.3/sdk.js"></script>
<!-- Google Fonts: Google Sans alternative (Nunito + Poppins) -->
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800;900&family=Poppins:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">

<style>
/* ══════════════════════════════════════════════
   DESIGN SYSTEM — Nail Kloset: Bright & Fresh
   ══════════════════════════════════════════════ */
:root {
  --pink:        #FF6B9D;
  --pink2:       #FF4785;
  --pink-light:  #FFE4EF;
  --pink-pale:   #FFF5F9;
  --pink-border: rgba(255,107,157,0.2);
  --sky:         #38BDF8;
  --sky-light:   #E0F6FF;
  --mint:        #2DD4BF;
  --mint-light:  #CCFBF1;
  --gold:        #FBBF24;
  --gold-light:  #FEF3C7;
  --purple:      #A78BFA;
  --purple-light:#EDE9FE;
  --green:       #10B981;
  --green-light: #D1FAE5;
  --white:       #FFFFFF;
  --bg:          #F8FAFF;
  --bg2:         #F0F4FF;
  --surface:     #FFFFFF;
  --text:        #1E293B;
  --text2:       #475569;
  --text3:       #94A3B8;
  --border:      #E2E8F0;
  --shadow-sm:   0 2px 8px rgba(0,0,0,0.06);
  --shadow:      0 4px 20px rgba(0,0,0,0.08);
  --shadow-lg:   0 8px 40px rgba(0,0,0,0.12);
  --radius:      20px;
  --radius-sm:   12px;
  --radius-xs:   8px;
  --ff:          'Nunito', sans-serif;
  --ff2:         'Poppins', sans-serif;
}

*,*::before,*::after { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }
html { scroll-behavior:smooth; }
body {
  font-family: var(--ff);
  background: var(--bg);
  color: var(--text);
  min-height: 100vh;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}

/* ── LOADING ─────────────────────────────────── */
#loading-screen {
  position: fixed; inset: 0; z-index: 1000;
  background: linear-gradient(135deg, #FF6B9D 0%, #FF9AC7 50%, #FFB3D9 100%);
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  transition: opacity 0.5s, transform 0.5s;
}
#loading-screen.out { opacity:0; pointer-events:none; transform: scale(1.05); }
.loading-logo {
  font-family: var(--ff2);
  font-size: 38px; font-weight: 700;
  color: #fff; letter-spacing: -1px;
  margin-bottom: 6px;
  animation: popUp 0.6s cubic-bezier(0.175,0.885,0.32,1.275) both;
}
.loading-sub {
  font-size: 13px; letter-spacing: 3px;
  text-transform: uppercase; color: rgba(255,255,255,0.8);
  margin-bottom: 40px;
  animation: popUp 0.6s 0.1s cubic-bezier(0.175,0.885,0.32,1.275) both;
}
.loading-dots {
  display: flex; gap: 8px;
  animation: popUp 0.6s 0.2s ease both;
}
.loading-dots span {
  width: 10px; height: 10px; border-radius: 50%;
  background: rgba(255,255,255,0.9);
  animation: bounce 1s ease infinite;
}
.loading-dots span:nth-child(2) { animation-delay: 0.15s; }
.loading-dots span:nth-child(3) { animation-delay: 0.3s; }

@keyframes bounce { 0%,80%,100%{transform:scale(0.6);opacity:0.5} 40%{transform:scale(1);opacity:1} }
@keyframes popUp  { from{opacity:0;transform:translateY(16px)} to{opacity:1;transform:translateY(0)} }

/* ── SUCCESS SCREEN ──────────────────────────── */
#success-screen {
  position: fixed; inset: 0; z-index: 900;
  background: linear-gradient(160deg, #E0F6FF 0%, #F0FFF4 50%, #FFF5F9 100%);
  display: none; flex-direction: column;
  align-items: center; justify-content: center;
  padding: 32px; text-align: center;
}
#success-screen.show { display: flex; }
.success-anim {
  width: 96px; height: 96px; border-radius: 50%;
  background: linear-gradient(135deg, #10B981, #34D399);
  display: flex; align-items: center; justify-content: center;
  font-size: 40px; margin-bottom: 24px;
  box-shadow: 0 12px 40px rgba(16,185,129,0.35);
  animation: popUp 0.6s cubic-bezier(0.175,0.885,0.32,1.275) both;
}
.success-title {
  font-family: var(--ff2); font-size: 28px; font-weight: 700;
  color: var(--text); margin-bottom: 8px;
}
.success-sub { font-size: 15px; color: var(--text2); line-height: 1.7; margin-bottom: 28px; }
.success-card {
  background: var(--white); border-radius: var(--radius);
  padding: 22px; width: 100%; max-width: 340px;
  margin-bottom: 24px; text-align: left;
  box-shadow: var(--shadow);
}
.success-card-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 9px 0; border-bottom: 1px solid var(--border); font-size: 14px;
}
.success-card-row:last-child { border-bottom: none; }
.sc-label { color: var(--text3); font-weight: 500; }
.sc-value  { font-weight: 700; color: var(--text); text-align: right; max-width: 56%; }
.bk-id-badge {
  font-size: 11px; color: var(--text3); margin-bottom: 20px;
  letter-spacing: 1px; text-transform: uppercase;
}

/* ── HEADER ──────────────────────────────────── */
.app-header {
  background: linear-gradient(135deg, #FF6B9D 0%, #FF9AC7 100%);
  padding: 20px 20px 16px;
  position: sticky; top: 0; z-index: 50;
  box-shadow: 0 4px 20px rgba(255,107,157,0.3);
}
.header-top {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 14px;
}
.app-logo {
  font-family: var(--ff2); font-size: 24px; font-weight: 700;
  color: #fff; letter-spacing: -0.5px;
}
.app-logo span { opacity: 0.7; font-size: 13px; font-weight: 400; display: block; letter-spacing: 0; }
.user-chip {
  display: flex; align-items: center; gap: 8px;
  background: rgba(255,255,255,0.25); border: 1px solid rgba(255,255,255,0.4);
  border-radius: 50px; padding: 5px 12px 5px 5px;
  backdrop-filter: blur(8px);
}
.user-avatar {
  width: 28px; height: 28px; border-radius: 50%;
  background: rgba(255,255,255,0.3);
  border: 2px solid rgba(255,255,255,0.6);
  display: flex; align-items: center; justify-content: center;
  overflow: hidden; font-size: 12px; flex-shrink: 0;
}
.user-avatar img { width:100%; height:100%; object-fit:cover; }
.user-chip-name { font-size: 12px; font-weight: 600; color: #fff; max-width:100px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }

/* ── STEP RAIL ───────────────────────────────── */
.step-rail {
  display: flex; align-items: center;
  background: rgba(255,255,255,0.15); border-radius: 50px;
  padding: 8px 14px; gap: 0;
}
.step {
  flex: 1; display: flex; flex-direction: column;
  align-items: center; gap: 3px; position: relative;
}
.step:not(:last-child)::after {
  content: ''; position: absolute;
  top: 12px; left: calc(50% + 14px); right: calc(-50% + 14px);
  height: 2px;
  background: rgba(255,255,255,0.3);
  transition: background 0.3s;
}
.step.done:not(:last-child)::after { background: rgba(255,255,255,0.8); }
.step-node {
  width: 24px; height: 24px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 11px; font-weight: 800;
  background: rgba(255,255,255,0.2); color: rgba(255,255,255,0.7);
  position: relative; z-index: 1;
  transition: all 0.3s;
}
.step.active .step-node {
  background: #fff; color: var(--pink); font-weight: 900;
  box-shadow: 0 0 0 4px rgba(255,255,255,0.3);
}
.step.done .step-node { background: rgba(255,255,255,0.9); color: var(--pink2); }
.step-label { font-size: 10px; color: rgba(255,255,255,0.7); font-weight: 600; }
.step.active .step-label { color: #fff; font-weight: 800; }
.step.done  .step-label { color: rgba(255,255,255,0.9); }

/* ── PAGES ───────────────────────────────────── */
.page { display: none; padding: 20px 16px 110px; animation: fadeSlide 0.3s ease both; }
.page.active { display: block; }
@keyframes fadeSlide { from{opacity:0;transform:translateY(10px)} to{opacity:1;transform:translateY(0)} }

.page-header { margin-bottom: 22px; }
.page-tag {
  display: inline-flex; align-items: center; gap: 6px;
  background: var(--pink-light); color: var(--pink2);
  font-size: 11px; font-weight: 800; letter-spacing: 1px;
  text-transform: uppercase; padding: 5px 12px;
  border-radius: 50px; margin-bottom: 12px;
}
.page-title {
  font-family: var(--ff2); font-size: 26px; font-weight: 700;
  color: var(--text); line-height: 1.2; margin-bottom: 6px;
}
.page-title em { font-style: normal; color: var(--pink); }
.page-sub { font-size: 14px; color: var(--text3); font-weight: 500; }

/* ── SERVICE CARDS ───────────────────────────── */
.service-list { display: flex; flex-direction: column; gap: 12px; }
.service-card {
  background: var(--white); border: 2px solid var(--border);
  border-radius: var(--radius); padding: 16px;
  cursor: pointer; transition: all 0.2s;
  display: flex; align-items: center; gap: 14px;
  position: relative; overflow: hidden;
  box-shadow: var(--shadow-sm);
}
.service-card::before {
  content: ''; position: absolute;
  left: 0; top: 0; bottom: 0; width: 4px;
  background: transparent; border-radius: 4px 0 0 4px;
  transition: background 0.2s;
}
.service-card:active { transform: scale(0.98); }
.service-card.selected {
  border-color: var(--pink);
  background: var(--pink-pale);
  box-shadow: 0 4px 20px rgba(255,107,157,0.15);
}
.service-card.selected::before { background: var(--pink); }
.svc-icon-wrap {
  width: 52px; height: 52px; border-radius: 16px;
  background: var(--bg2);
  display: flex; align-items: center; justify-content: center;
  font-size: 24px; flex-shrink: 0;
  transition: background 0.2s;
}
.service-card.selected .svc-icon-wrap { background: var(--pink-light); }
.svc-info { flex: 1; min-width: 0; }
.svc-name { font-size: 15px; font-weight: 700; color: var(--text); margin-bottom: 3px; }
.svc-meta { font-size: 12px; color: var(--text3); font-weight: 500; }
.svc-price {
  font-size: 15px; font-weight: 800; color: var(--pink);
  text-align: right; flex-shrink: 0;
}
.svc-price small { display: block; font-size: 10px; font-weight: 500; color: var(--text3); }
.check-badge {
  position: absolute; top: 10px; right: 10px;
  width: 22px; height: 22px; border-radius: 50%;
  background: var(--pink); display: none;
  align-items: center; justify-content: center;
  color: #fff; font-size: 12px; font-weight: 800;
}
.service-card.selected .check-badge { display: flex; }

/* ── STAFF GRID ──────────────────────────────── */
.staff-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 12px; }
.staff-card {
  background: var(--white); border: 2px solid var(--border);
  border-radius: var(--radius); padding: 18px 14px;
  cursor: pointer; transition: all 0.2s;
  text-align: center; position: relative;
  box-shadow: var(--shadow-sm);
}
.staff-card:active { transform: scale(0.97); }
.staff-card.selected {
  border-color: var(--pink); background: var(--pink-pale);
  box-shadow: 0 4px 20px rgba(255,107,157,0.15);
}
.staff-card.any-card {
  grid-column: 1 / -1; display: flex;
  align-items: center; gap: 14px;
  text-align: left; padding: 16px 18px;
  background: linear-gradient(135deg, var(--sky-light), #E0F6FF);
  border-color: var(--sky);
}
.staff-card.any-card.selected {
  border-color: var(--pink); background: var(--pink-pale);
}
.staff-ava {
  width: 58px; height: 58px; border-radius: 50%;
  background: linear-gradient(135deg, var(--pink-light), var(--purple-light));
  border: 3px solid var(--border);
  display: flex; align-items: center; justify-content: center;
  font-size: 18px; font-weight: 800; color: var(--pink);
  margin: 0 auto 10px; overflow: hidden;
  font-family: var(--ff2);
}
.any-card .staff-ava {
  margin: 0; flex-shrink: 0;
  background: linear-gradient(135deg, var(--sky-light), #BAE6FD);
  border-color: var(--sky); color: #0284C7;
}
.staff-ava img { width:100%; height:100%; object-fit:cover; }
.staff-name { font-size: 14px; font-weight: 800; color: var(--text); margin-bottom: 3px; }
.staff-role { font-size: 12px; color: var(--text3); font-weight: 500; }
.staff-check {
  position: absolute; top: 8px; right: 8px;
  width: 20px; height: 20px; border-radius: 50%;
  background: var(--pink); display: none;
  align-items: center; justify-content: center;
  color: #fff; font-size: 11px; font-weight: 800;
}
.staff-card.selected .staff-check { display: flex; }

/* ── CALENDAR ────────────────────────────────── */
.cal-wrap {
  background: var(--white); border-radius: var(--radius);
  padding: 20px; margin-bottom: 20px;
  box-shadow: var(--shadow-sm); border: 1px solid var(--border);
}
.cal-header {
  display: flex; align-items: center;
  justify-content: space-between; margin-bottom: 20px;
}
.cal-month-lbl {
  font-family: var(--ff2); font-size: 18px; font-weight: 700; color: var(--text);
}
.cal-nav {
  width: 38px; height: 38px; border-radius: var(--radius-xs);
  border: 2px solid var(--border); background: var(--bg);
  cursor: pointer; display: flex; align-items: center; justify-content: center;
  font-size: 18px; color: var(--text2); transition: all 0.2s;
}
.cal-nav:hover { border-color: var(--pink); color: var(--pink); background: var(--pink-pale); }
.cal-grid {
  display: grid; grid-template-columns: repeat(7,1fr);
  gap: 4px; margin-bottom: 0;
}
.cal-dow {
  text-align: center; font-size: 11px; font-weight: 700;
  color: var(--text3); padding: 6px 0; letter-spacing: 0.5px;
}
.cal-day {
  aspect-ratio: 1; border-radius: var(--radius-xs);
  display: flex; align-items: center; justify-content: center;
  font-size: 13px; font-weight: 600; cursor: pointer;
  color: var(--text2); transition: all 0.2s;
  border: 2px solid transparent;
}
.cal-day:hover:not(.disabled):not(.empty) {
  background: var(--pink-pale); color: var(--pink); border-color: var(--pink-border);
}
.cal-day.today { color: var(--pink); font-weight: 900; }
.cal-day.today::after {
  content: ''; position: absolute; bottom: 2px;
  width: 5px; height: 5px; border-radius: 50%;
  background: var(--pink);
}
.cal-day { position: relative; }
.cal-day.selected {
  background: var(--pink) !important; color: #fff !important;
  border-color: var(--pink) !important; font-weight: 800;
  box-shadow: 0 4px 12px rgba(255,107,157,0.4);
}
.cal-day.disabled { color: var(--border); cursor: not-allowed; }
.cal-day.empty    { cursor: default; }

/* ── TIME SLOTS ──────────────────────────────── */
.time-section { margin-top: 20px; }
.time-section-hd {
  font-size: 12px; font-weight: 800; letter-spacing: 1.5px;
  text-transform: uppercase; color: var(--text3); margin-bottom: 10px;
  display: flex; align-items: center; gap: 6px;
}
.time-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 8px; }
.time-slot {
  background: var(--white); border: 2px solid var(--border);
  border-radius: var(--radius-sm); padding: 12px 8px;
  text-align: center; font-size: 14px; font-weight: 700;
  cursor: pointer; transition: all 0.2s;
  color: var(--text2); box-shadow: var(--shadow-sm);
}
.time-slot:hover:not(.unavailable) {
  border-color: var(--pink); color: var(--pink);
  background: var(--pink-pale);
}
.time-slot.selected {
  background: var(--pink) !important; border-color: var(--pink) !important;
  color: #fff !important; font-weight: 800;
  box-shadow: 0 4px 16px rgba(255,107,157,0.4);
}
.time-slot.unavailable {
  background: var(--bg2); color: var(--border);
  cursor: not-allowed; border-color: transparent;
  text-decoration: line-through;
}
.time-end {
  display: block; font-size: 10px; opacity: 0.7;
  margin-top: 2px; font-weight: 500;
}
.time-loading { padding: 24px 0; text-align: center; }
.time-loading-shimmer {
  height: 50px; border-radius: var(--radius-sm);
  background: linear-gradient(90deg, var(--border) 25%, var(--bg2) 50%, var(--border) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.4s ease infinite; margin-bottom: 8px;
}
@keyframes shimmer { 0%{background-position:200% 0} 100%{background-position:-200% 0} }
.no-date-msg {
  text-align: center; padding: 32px 0;
  color: var(--text3); font-size: 14px; font-weight: 500;
}

/* ── CONFIRM PAGE ────────────────────────────── */
.profile-card {
  background: linear-gradient(135deg, var(--pink-pale), var(--sky-light));
  border: 2px solid var(--pink-border); border-radius: var(--radius);
  padding: 16px 18px; display: flex; align-items: center;
  gap: 14px; margin-bottom: 20px;
}
.profile-ava {
  width: 54px; height: 54px; border-radius: 50%;
  background: var(--pink-light); border: 3px solid var(--pink-border);
  overflow: hidden; display: flex; align-items: center;
  justify-content: center; font-size: 22px; flex-shrink: 0;
}
.profile-ava img { width:100%; height:100%; object-fit:cover; }
.profile-name { font-size: 16px; font-weight: 800; color: var(--text); }
.profile-sub  { font-size: 12px; color: var(--pink); font-weight: 600; }

.form-label { font-size: 13px; font-weight: 700; color: var(--text2); margin-bottom: 8px; display: block; }
.form-input {
  width: 100%; background: var(--white);
  border: 2px solid var(--border); border-radius: var(--radius-sm);
  padding: 14px 16px; font-size: 15px; font-family: var(--ff);
  color: var(--text); outline: none; margin-bottom: 18px;
  transition: border-color 0.2s; -webkit-appearance: none;
  font-weight: 600;
}
.form-input:focus { border-color: var(--pink); }
.form-input::placeholder { color: var(--text3); font-weight: 400; }
.form-input.error { border-color: #EF4444; }
.form-textarea { resize: none; height: 80px; }

.summary-card {
  background: var(--white); border: 2px solid var(--border);
  border-radius: var(--radius); overflow: hidden;
  margin-bottom: 20px; box-shadow: var(--shadow-sm);
}
.summary-head {
  background: linear-gradient(135deg, var(--pink), var(--pink2));
  padding: 18px 20px;
  display: flex; align-items: center; gap: 12px;
}
.summary-head-icon { font-size: 24px; }
.summary-head-title { font-family: var(--ff2); font-size: 17px; font-weight: 700; color: #fff; }
.summary-head-sub   { font-size: 11px; color: rgba(255,255,255,0.75); margin-top: 1px; }
.summary-body { padding: 18px 20px; }
.sum-row {
  display: flex; justify-content: space-between; align-items: flex-start;
  padding: 10px 0; border-bottom: 1px solid var(--border);
}
.sum-row:last-child { border-bottom: none; }
.sum-label { font-size: 13px; color: var(--text3); font-weight: 600; }
.sum-value { font-size: 14px; font-weight: 800; color: var(--text); text-align: right; max-width: 62%; }
.sum-price-big { font-family: var(--ff2); font-size: 28px; font-weight: 800; color: var(--pink); }

.policy-box {
  background: var(--gold-light); border: 2px solid #FDE68A;
  border-radius: var(--radius-sm); padding: 14px 16px; margin-bottom: 20px;
}
.policy-box p { font-size: 13px; color: #92400E; font-weight: 600; line-height: 1.7; }

/* ── MY BOOKINGS ─────────────────────────────── */
.tabs { display: flex; gap: 8px; margin-bottom: 18px; overflow-x: auto; padding-bottom: 2px; }
.tab-btn {
  padding: 10px 18px; border-radius: 50px;
  border: 2px solid var(--border); background: var(--white);
  font-family: var(--ff); font-size: 13px; font-weight: 700;
  color: var(--text3); cursor: pointer; white-space: nowrap;
  transition: all 0.2s; flex-shrink: 0;
}
.tab-btn.active { background: var(--pink); border-color: var(--pink); color: #fff; }
.booking-item {
  background: var(--white); border: 2px solid var(--border);
  border-radius: var(--radius); padding: 18px; margin-bottom: 12px;
  box-shadow: var(--shadow-sm);
}
.bk-service { font-size: 16px; font-weight: 800; color: var(--text); margin-bottom: 6px; }
.bk-details { font-size: 13px; color: var(--text2); line-height: 1.8; font-weight: 500; }
.bk-status {
  font-size: 11px; font-weight: 800; padding: 4px 10px;
  border-radius: 50px; letter-spacing: 0.3px;
}
.bk-pending   { background: var(--gold-light);   color: #B45309; }
.bk-confirmed { background: var(--green-light);  color: #065F46; }
.bk-cancelled { background: var(--bg2);          color: var(--text3); }
.bk-completed { background: var(--sky-light);    color: #0369A1; }
.bk-cancel-btn {
  margin-top: 14px; width: 100%; background: transparent;
  border: 2px solid #FCA5A5; border-radius: 50px; padding: 10px;
  font-family: var(--ff); font-size: 13px; font-weight: 700;
  color: #EF4444; cursor: pointer; transition: all 0.2s;
}
.bk-cancel-btn:hover { background: #FEF2F2; }

/* ── BUTTONS ─────────────────────────────────── */
.btn-primary {
  width: 100%;
  background: linear-gradient(135deg, var(--pink), var(--pink2));
