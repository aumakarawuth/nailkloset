    return `
    <div class="staff-card ${s.isAny ? 'any-card' : ''}" id="stc_${s.id}" onclick="selectStaff('${s.id}')">
      <div class="staff-ava" style="${s.isAny ? '' : `background:linear-gradient(135deg,${col}22,${col}44);color:${col}`}">
        ${s.image ? `<img src="${s.image}" alt="">` : ini}
      </div>
      <div style="flex:${s.isAny?1:'unset'}">
        <div class="staff-name">${s.name}</div>
        <div class="staff-role">${s.bio || (s.isAny ? 'อัตโนมัติ' : 'ช่างเล็บ')}</div>
      </div>
      <div class="staff-check">✓</div>
    </div>`;
  }).join('');
